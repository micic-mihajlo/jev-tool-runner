direction: right
classes: {
  box: {
    style: {
      border-radius: 10
      fill: "#eef4ff"
      stroke: "#4f6b9a"
    }
  }
}
request: "Codex requests next step" { class: box }
router: "Local provider adapter\nBuild eligible native calls" { class: box }
jev: "Jev selects ONE call\nGoal + call metadata only" { class: box }
runtime: "Codex tool runtime\nNormal approvals + sandbox" { class: box }
result: "Actual tool result\nStays in Codex conversation" { class: box }
model: "Coding model\nReasoning, edits, final answer" { class: box }
request -> router
router -> jev: eligible
jev -> runtime: native tool-call response
runtime -> result
result -> request: next step
router -> model: unsupported / complete / failure
jev -> model: handoff
